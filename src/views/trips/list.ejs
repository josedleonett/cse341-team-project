<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    <label for="region-filter">Search by Region:</label>
    <select id="region-filter" name="region">
        <option value="all">All Regions</option>
    </select>

    <label for="season-filter">Search by Season:</label>
    <select id="season-filter" name="season">
        <option value="all">Any Season</option>
    </select>
</div>

<p id="trips-loading" class="trips-state" role="status">Loading trips...</p>
<p id="trips-error" class="trips-state" role="alert" hidden></p>
<p id="trips-empty" class="trips-state" role="status" hidden>No trips match these filters.</p>
<div class="routes-grid" id="trips-list"></div>

<template id="trip-card-template">
    <article class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name" data-field="start-station"></div>
            </div>
            <div class="route-arrow">&#8594;</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name" data-field="end-station"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">&#128337;</span>
                <span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">&#128205;</span>
                <span><span class="detail-label">Distance:</span> <span data-field="distance"></span></span>
            </div>
            <div class="detail-item">
                <span class="season-badge" data-field="season"></span>
            </div>
        </div>

        <p class="route-description" data-field="description"></p>

        <div class="highlights" data-field="highlights-container">
            <div class="highlights-list" data-field="highlights"></div>
        </div>

        <div class="route-actions">
            <a href="#" class="view-details-btn" data-field="details-link">View Details &amp; Book &#8594;</a>
        </div>
    </article>
</template>

<script src="/js/trips.js" defer></script>

<%- include('../partials/footer') %>